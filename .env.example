# Google Gemini API key for server-side AI explanations (optional)
GEMINI_API_KEY=

# Real Java Execution Backend API URL (for Vercel deployment)
# - Leave empty for local development or when backend is hosted on the same origin
# - For Vercel deployments, configure this to point to your live JDK-enabled container
#   e.g. https://codeflow-backend.onrender.com or https://codeflow-api.railway.app
# Both variable names are supported:
VITE_JAVA_EXECUTION_API_URL=
JAVA_EXECUTION_API_URL=
